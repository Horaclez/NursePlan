{
  "name": "q-plan",
  "version": "3.0.0",
  "description": "Q-PLAN — Diseño colaborativo, trazabilidad metodológica y auditoría de Planes de Mejora Continua en salud",
  "main": "electron/main.js",
  "author": "Q-PLAN Salud",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "cap:sync": "npx cap sync android"
  },
  "build": {
    "appId": "cl.qplan.mejora",
    "productName": "Q-PLAN",
    "directories": {
      "output": "dist"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "www/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Q-PLAN"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2"
  }
}